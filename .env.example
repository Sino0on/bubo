# Скопируйте этот файл в .env и заполните значения

# В проде: DEBUG=False (обязательно) и SECRET_KEY сгенерированный (например: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Путь до админки (по умолчанию admin/) — в проде лучше сменить на непредсказуемый
ADMIN_URL=admin/

# Telegram бот для уведомлений о заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USERNAME=BuboStore

# WhatsApp (номер без +, пример: 996700000000)
WHATSAPP_PHONE=996700000000

# Аналитика (опционально)
YANDEX_METRIKA_ID=
GOOGLE_ANALYTICS_ID=

# PostgreSQL (DATABASE_URL включает Postgres в settings.py; сами настройки читаются из POSTGRES_*)
POSTGRES_DB=bubostore
POSTGRES_USER=bubostore
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bubostore:change-me@db:5432/bubostore

# Мониторинг ошибок (опционально, https://sentry.io)
SENTRY_DSN=
ENVIRONMENT=production
RELEASE=
# Доля трейсов/профилей, отправляемых в Sentry (0.0-1.0)
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILE_SAMPLE_RATE=0.2
# Отправлять PII (IP, куки и т.п.) в Sentry — по умолчанию False, т.к. заказы содержат имена/телефоны покупателей
SENTRY_SEND_PII=False
DJANGO_LOG_LEVEL=INFO

# Создание суперпользователя через create_superuser.py (без дефолтов — обязателен для прода)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@bubostore.kg
DJANGO_SUPERUSER_PASSWORD=
